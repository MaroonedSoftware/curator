{
    "name": "curator",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "db:up": "docker compose up -d --wait db db-test",
        "db:reset": "docker compose rm -sfv db && docker volume rm -f curator_curator-db && docker compose up -d --wait db && turbo run migrate:up",
        "migrate:up": "turbo run migrate:up"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "eslint": "^10.12.0",
        "prettier": "^3.9.9",
        "turbo": "^2.11.7",
        "typescript": "6.0.3",
        "vitest": "^5.0.3"
    },
    "packageManager": "pnpm@11.10.0",
    "engines": {
        "node": ">=26"
    }
}
