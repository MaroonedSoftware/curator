{
    "$schema": "https://turborepo.com/schema.json",
    "agentGuidance": false,
    "globalEnv": [
        "NODE_ENV",
        "BUILD_VERSION",
        "BUILD_REVISION",
        "DATABASE_URL",
        "TEST_DATABASE_HOST",
        "TEST_DATABASE_PORT",
        "TEST_DATABASE_USER",
        "TEST_DATABASE_PASSWORD",
        "TEST_DATABASE_NAME"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "lint:check": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "migrate:up": {
            "cache": false
        }
    }
}
