{
    "name": "@curator/api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "HTTP API over the Frame client",
    "license": "MIT",
    "scripts": {
        "dev": "node --no-warnings --import @swc-node/register/esm-register --enable-source-maps --watch --watch-preserve-output ./src/index.ts",
        "start": "node --enable-source-maps ./dist/index.js",
        "build": "tsc",
        "build:ci": "eslint --max-warnings=0 && pnpm run build",
        "typecheck": "tsc -p tsconfig.tests.json --noEmit",
        "lint": "eslint --fix",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run"
    },
    "dependencies": {
        "@curator/frame": "workspace:*",
        "@fastify/cors": "^11.3.1",
        "@maroonedsoftware/appconfig": "^2.6.1",
        "@maroonedsoftware/errors": "^1.9.1",
        "@maroonedsoftware/fastify": "^0.4.5",
        "@maroonedsoftware/logger": "^1.1.9",
        "@maroonedsoftware/zod": "^0.8.0",
        "fast-json-stringify": "^7.0.0",
        "fastify": "^5.12.5",
        "injectkit": "^1.7.1",
        "reflect-metadata": "^0.2.2",
        "yaml": "^2.9.1",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.13",
        "@types/node": "^26.6.5",
        "eslint": "^10.12.0",
        "typescript": "6.0.3",
        "vitest": "^5.0.3"
    }
}
