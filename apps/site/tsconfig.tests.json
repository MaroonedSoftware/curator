{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Type-check only: covers tests/ as well as src/, which the build tsconfig leaves out.
        "noEmit": true,
        // The sync script is plain `.mjs` that node runs as it is, typed with JSDoc, and the tests
        // import it.
        "allowJs": true,
        "checkJs": true
    },
    "include": ["./src/**/*", "./tests/**/*", "./scripts/**/*.mjs", "./docusaurus.config.ts", "./sidebars.ts", "./vitest.config.ts"],
    "exclude": ["node_modules", "dist", ".docusaurus"]
}
