{
    "name": "@curator/site",
    "private": true,
    "license": "MIT",
    "description": "The public website: what curator is, how to run it, and the API and Frame client it is built on.",
    "scripts": {
        "start": "node scripts/docs.sync.mjs && docusaurus start --port 14104",
        "build": "tsc --noEmit && node scripts/docs.sync.mjs && docusaurus build --out-dir dist",
        "serve": "docusaurus serve --dir dist --port 14105",
        "clear": "docusaurus clear",
        "lint": "eslint --fix",
        "lint:check": "eslint --max-warnings=0",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
        "test": "vitest run",
        "format": "prettier --write . --ignore-path ../../.prettierignore"
    },
    "devDependencies": {
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/faster": "^3.10.2",
        "@docusaurus/module-type-aliases": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "@docusaurus/theme-classic": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@fontsource-variable/inter": "^5.2.8",
        "@mdx-js/react": "^3.1.0",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@types/node": "^26.6.5",
        "@types/react": "^19.2.18",
        "eslint": "^10.12.0",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "6.0.3",
        "vitest": "^5.0.3"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    }
}
