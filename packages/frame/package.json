{
    "name": "@curator/frame",
    "version": "0.2.3",
    "private": true,
    "type": "module",
    "description": "Client for the Samsung The Frame art-mode protocol",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
        "build:ci": "eslint --max-warnings=0 && pnpm run build",
        "typecheck": "tsc -p tsconfig.tests.json --noEmit",
        "lint": "eslint --fix",
        "lint:check": "eslint --max-warnings=0",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run",
        "probe": "node --no-warnings --import @swc-node/register/esm-register scripts/frame.probe.ts",
        "fake:tv": "node --no-warnings --import @swc-node/register/esm-register scripts/fake.tv.serve.ts"
    },
    "dependencies": {
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.13",
        "@types/node": "^26.6.5",
        "@types/ws": "^8.18.2",
        "eslint": "^10.12.0",
        "sharp": "^0.35.5",
        "tsup": "^8.5.1",
        "typescript": "6.0.3",
        "vitest": "^5.0.3"
    }
}
